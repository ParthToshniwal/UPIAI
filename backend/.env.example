# Turso (libsql) Database Configuration
# Remote Turso: TURSO_DATABASE_URL=libsql://[your-db].turso.io, TURSO_AUTH_TOKEN=[your-token]
# Local embedded/dev mode: TURSO_DATABASE_URL=file:upiai_turso.db (or leave blank for automatic local SQLite)
TURSO_DATABASE_URL=file:upiai_turso.db
TURSO_AUTH_TOKEN=
DATABASE_NAME=upiai_turso_db

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# CORS Allowed Origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8501,http://127.0.0.1:8501,https://*.vercel.app
