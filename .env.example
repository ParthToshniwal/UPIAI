# MongoDB Atlas / Local MongoDB URI
MONGO_URI=mongodb://localhost:27017/upiai_db
DATABASE_NAME=upiai_db

# Backend App Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security & CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# MLflow Experiment Tracking
MLFLOW_TRACKING_URI=./mlruns
MLFLOW_EXPERIMENT_NAME=upiai_demand_forecasting

# Provenance & Audit Logging
PROVENANCE_LOG_ENABLED=true
DATA_DIR=./data
MODELS_DIR=./models
